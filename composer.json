{
    "name": "mamluk/aybak",
    "description": "Keeps the load balancer in front of a Kubernetes cluster in step with its nodes.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Aybak\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aybak\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
