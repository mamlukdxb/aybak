#!/usr/bin/env php
<?php

declare(strict_types=1);

// Aybak: keeps the load balancer in front of a Kubernetes cluster in step with
// its nodes. Every setting is described in README.md.

require dirname(__DIR__) . '/vendor/autoload.php';

use Aybak\Config;
use Aybak\Http\CurlTransport;
use Aybak\Kubernetes;
use Aybak\Log;
use Aybak\Output\DataPlane;
use Aybak\Output\Git;
use Aybak\Output\Webhook;
use Aybak\Runner;

$log = new Log();
$env = getenv();

try {
    $config = Config::fromEnvironment($env);
    $http = new CurlTransport();
    $kubernetes = Kubernetes::inCluster($http, $env);
} catch (\Throwable $e) {
    $log->error('Aybak cannot start.', ['error' => $e->getMessage()]);
    exit(2);
}

foreach ([$config->stateDir, "{$config->stateDir}/status"] as $dir) {
    if (!is_dir($dir) && !mkdir($dir, 0700, true)) {
        $log->error('Aybak cannot start: its state directory cannot be created.', ['dir' => $dir]);
        exit(2);
    }
}

$outputs = [];
foreach ($config->outputs as $name) {
    $outputs[] = match ($name) {
        'git' => new Git(
            (string) $config->gitUrl, $config->gitBranch, $config->gitPath,
            (string) $config->gitKeyFile, (string) $config->gitKnownHostsFile,
            "{$config->stateDir}/repository", $config->gitAuthorName, $config->gitAuthorEmail,
        ),
        'webhook' => new Webhook($http, (string) $config->webhookUrl, (string) $config->webhookKeyFile),
        'dataplane' => new DataPlane(
            $http, (string) $config->dataplaneUrl, (string) $config->dataplaneUser,
            (string) $config->dataplanePasswordFile, $config->dataplaneBackends, $config->dataplaneSendProxyV2,
        ),
    };
}

$runner = new Runner($config, $kubernetes->nodes(...), $outputs, $log, "{$config->stateDir}/status");

$stop = false;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, static function () use (&$stop): void { $stop = true; });
pcntl_signal(SIGINT, static function () use (&$stop): void { $stop = true; });

$log->info('Aybak started.', [
    'cluster' => $config->cluster, 'nodes' => $config->nodes, 'address' => $config->address,
    'outputs' => implode(',', $config->outputs), 'resync_seconds' => $config->resyncSeconds,
]);

while (!$stop) {
    $runner->pass(new DateTimeImmutable());
    for ($i = 0; $i < $config->resyncSeconds && !$stop; $i++) {
        sleep(1);
    }
}

$log->info('Aybak stopped.');
